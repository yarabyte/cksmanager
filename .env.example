# PostgreSQL — base alignée sur etape1.sql (import via seed)
DATABASE_URL="postgresql://shakemill:@localhost:5432/cksmanager?schema=public"

# Obligatoire en production (Coolify). Chaîne aléatoire longue.
AUTH_SECRET=

# WasenderApi — notifications WhatsApp patients
# https://wasenderapi.com/api-docs
# Prérequis : session WhatsApp connectée sur le dashboard Wasender + clé API Bearer
WASENDER_API_KEY=
WASENDER_API_BASE_URL=https://www.wasenderapi.com
WHATSAPP_NOTIFICATIONS_ENABLED=false
# Optionnel — sinon Parametre.nomClinique
WHATSAPP_CLINIC_NAME=
